{
  "name": "@promptbook/electron",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "concurrently \"tsc -w\" \"vite\"",
    "start": "electron .",
    "restart": "pkill -f 'electron .' || true && npm run build && electron .",
    "package": "electron-builder",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.23",
    "@anthropic-ai/sdk": "^0.72.0",
    "@promptbook/core": "workspace:*",
    "electron-context-menu": "^3.6.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-window-state": "^5.0.3",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "playwright": "^1.58.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.promptbook.app",
    "productName": "Promptbook",
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
